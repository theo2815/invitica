{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invitica-viewer",
  "main": "src/index.ts",
  "tsconfig": "./tsconfig.json",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/i/*", "/m/*", "/s/*"]
  },
  "r2_buckets": [
    {
      "binding": "PUBLICATION_BUCKET",
      "bucket_name": "invitica-storage"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  // Client-exposed, domain-restricted MapTiler key for the guest venue map (ADR-006). Declared
  // empty here so no key is committed, and declared at all so `wrangler types --check` stays
  // reproducible without the git-ignored `.dev.vars`. Local `wrangler dev` reads that file.
  //
  // Because this block is deployed configuration, an empty value here overwrites whatever the
  // Worker had — a dashboard-entered key does NOT survive a deploy, and an empty one silently
  // blanks every guest map. Deploy through `pnpm --filter @invitica/viewer deploy`, which supplies
  // the key from the environment and refuses to deploy without it. Never bare `wrangler deploy`.
  "vars": {
    "MAPTILER_KEY": "",
    "PUBLIC_INVITATION_ORIGIN": "https://invitica.app"
  },
  "env": {
    "production": {
      "name": "invitica-viewer-production",
      "r2_buckets": [
        {
          "binding": "PUBLICATION_BUCKET",
          "bucket_name": "invitica-storage"
        }
      ],
      "vars": {
        "MAPTILER_KEY": "",
        "PUBLIC_INVITATION_ORIGIN": "https://invitica.app"
      }
    }
  }
}
