# Supabase project configuration safe for browser use.
# Copy this file to .env.local in this directory and replace the placeholders
# with values from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_INVITATION_ORIGIN=http://localhost:3000

# Trigger.dev is server-only. Create the project separately, then provide its
# development or production secret to the matching web environment.
TRIGGER_SECRET_KEY=tr_dev_replace_me

# Guest-link resolution and creator recovery are server-only. Use separate
# 32-byte base64url secrets for keyed hashes and AES-GCM encryption. Increment
# the positive key version only with a reviewed rotation and compatibility plan.
GUEST_LINK_HASH_KEY=replace_with_43_character_base64url_secret
GUEST_LINK_ENCRYPTION_KEY=replace_with_a_different_43_character_base64url_secret
GUEST_LINK_ENCRYPTION_KEY_VERSION=1
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Cloudflare R2 (server-only) backs creator image upload and publication media
# resolution. Use least-privilege S3 credentials scoped to the private media
# bucket. Never expose these in a NEXT_PUBLIC variable.
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=invitica-storage

# Google OAuth credentials belong in Supabase Dashboard -> Authentication ->
# Providers -> Google. Never place Supabase secret/service-role keys or the
# Google client secret in a NEXT_PUBLIC variable.

# MapTiler raster tiles power the guest venue map (ADR-006). This key is exposed
# to the browser by design (it rides in tile URLs), so it is NEXT_PUBLIC — but you
# MUST domain-restrict it in the MapTiler dashboard (Account -> Keys -> Allowed
# origins) to our origins so it cannot be reused elsewhere. Leave empty to disable
# the interactive map and fall back to the "Get directions" link.
NEXT_PUBLIC_MAPTILER_KEY=your_domain_restricted_maptiler_key_here
